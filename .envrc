# SPDX-License-Identifier: BSD-3-Clause
#
# Canonical entry point for a development shell: direnv loads this, it asks
# devenv for the shell described by devenv.nix and devenv.yaml.  No Nix
# expression here builds anything, and nothing in the Nix build reads this
# file.
#
# Requires direnv and devenv (https://devenv.sh).  Without devenv the answer
# is a refusal rather than a fallback to some other nixpkgs: a shell that
# silently used an unpinned tree would be a different environment wearing the
# same name.
if ! has devenv; then
  echo "htscodecs: devenv not found.  Install it from https://devenv.sh, then run 'direnv allow'." >&2
  exit 1
fi

eval "$(devenv direnvrc)"
use devenv
